{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // The FACTORY's own linter. Deliberately mirrors the Biome config the factory prescribes for
  // GENERATED projects (`modules/gate/source/biome.json`) — the factory should be held to the standard
  // it imposes on its output.
  //
  // It is NOT the same tool, and that is a real divergence: generated projects get Biome + a GritQL
  // naming plugin; the factory gets oxlint. Rule-for-rule mapping and the FIVE gaps that cannot be closed
  // are documented in docs/lint-parity.md — the largest being that the abbreviation/naming gate has no
  // oxlint counterpart at all, and that oxlint has no formatter. Read that before assuming a green oxlint
  // run means the code would pass the Biome gate the factory ships.

  "plugins": ["typescript", "unicorn", "oxc", "node", "promise", "vitest", "import"],

  // oxlint's `correctness` is the closest analogue to Biome's `recommended` preset. The stricter
  // categories (`pedantic`, `style`, `restriction`) are deliberately NOT enabled wholesale — Biome's
  // config picks individual rules rather than whole tiers, so enabling a tier here would make the two
  // configs diverge in ways nobody chose. Ratchet them on individually instead.
  "categories": {
    "correctness": "error"
  },

  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",

    // Templates destined for a GENERATED project, not factory code. They compile against that
    // project's tsconfig, use `@/*` aliases that only resolve there, and target TypeScript 7 while the
    // factory runs 5.9 — the same reason tsconfig.json and the Vitest `unit` project exclude them.
    // Linting them here would report findings that are not findings anywhere real.
    "modules/*/source",

    // Generated artifacts. `examples:check` guarantees they match the generator byte-for-byte, so the
    // only way to "fix" a finding here is to change the module that produced it — which oxlint would
    // flag there anyway if it were factory code.
    "examples"
  ],

  "rules": {
    // ── Biome complexity ────────────────────────────────────────────────────────────────────────
    "no-unneeded-ternary": "error", // ← noUselessTernary
    "typescript/no-unnecessary-type-constraint": "error", // ← noUselessTypeConstraint
    "vitest/max-nested-describe": "error", // ← noExcessiveNestedTestSuites
    "no-implicit-coercion": "error", // ← noImplicitCoercions
    "no-useless-concat": "error", // ← noUselessStringConcat

    // ← useMaxParams, but STRICTER than it. Biome's rule defaults to 4; this is 3, which matches the
    // project's actual convention ("options object at 3+ parameters"). In generated projects that tier is
    // review-enforced only, because Biome's useMaxParams cannot express it — here it is gated.
    //
    // So the factory is held to a tighter bar than its own output on this one rule. Deliberate: the
    // convention is real, and where a tool can enforce it, it should.
    "max-params": ["error", { "max": 3 }],

    // ← noExcessiveCognitiveComplexity, approximately. NOT the same metric: Biome measures COGNITIVE
    // complexity (nesting-weighted), oxlint/ESLint measure CYCLOMATIC (branch count). A function can
    // pass one and fail the other. 15 matches Biome's default threshold.
    "complexity": ["error", { "max": 15 }],

    // ── Biome correctness ───────────────────────────────────────────────────────────────────────
    // ← noUnusedImports. oxlint folds unused imports into no-unused-vars rather than splitting them.
    "no-unused-vars": "error",

    // ── Biome suspicious ────────────────────────────────────────────────────────────────────────
    "no-console": "warn", // ← noConsole (warn in Biome too)
    "typescript/ban-ts-comment": "error", // ← noTsIgnore
    "typescript/no-explicit-any": "error", // ← noExplicitAny
    "no-empty": "error", // ← noEmptyBlockStatements

    // ── Biome style ─────────────────────────────────────────────────────────────────────────────
    "no-nested-ternary": "error", // ← noNestedTernary
    "unicorn/numeric-separators-style": "error", // ← useNumericSeparators
    "typescript/only-throw-error": "error", // ← useThrowOnlyError
    "unicorn/throw-new-error": "error", // ← useThrowNewError
    "typescript/no-non-null-assertion": "error", // ← noNonNullAssertion
    "unicorn/explicit-length-check": "error", // ← useExplicitLengthCheck

    // ← noProcessEnv. OFF here and ERROR in the test override below, matching Biome's inversion: a
    // composition root legitimately reads env vars, but a test that reaches for `process.env` couples
    // to ambient state that dependency injection exists to avoid.
    "node/no-process-env": "off",

    // No Biome counterpart — kept because its "async assertions must be awaited" half caught two real
    // defects in this repo's own tests.
    //
    // `maxArgs: 2` is REQUIRED, not a relaxation. oxlint's default is 1 because the rule is modelled on
    // Jest, whose `expect` takes one argument. Vitest's does not: `@vitest/expect/dist/index.d.ts:184`
    // declares `<T>(actual: T, message?: string)`, and the message is prepended to the failure output.
    // Verified — `expect(false, 'MARKER').toBe(true)` reports `AssertionError: MARKER: expected false…`.
    // Leaving the default would have forced a choice between deleting every custom failure message in
    // the suite (the generation tests carry command output in theirs) and disabling the rule outright,
    // losing the await check with it.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],

    // Enabled by the `correctness` category above; listed here only to declare this repo's assertion
    // HELPERS. The rule flags a test whose body contains no `expect`, which is the right default and
    // catches a real mistake. But `tests/generation.test.ts` runs the same assertion pair against eight
    // package-manager combinations, so the pair lives in a named helper — and the rule then reads the
    // calling test as assertion-free.
    //
    // This is a declaration, NOT a relaxation: naming the helper is how the rule is told where the
    // assertions moved to. The alternative was inlining the pair back into each caller, which is the
    // duplication the helper exists to remove. A helper added later must be named here too, otherwise
    // its callers fail this rule — which is the intended failure, not a bug.
    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType", "expectOnlyThisManagersInstall"] }
    ],

    // ── Biome nursery ───────────────────────────────────────────────────────────────────────────
    "typescript/explicit-function-return-type": "warn", // ← useExplicitType (warn in Biome too)
    "vitest/no-conditional-expect": "error", // ← noConditionalExpect
    "typescript/no-unnecessary-type-conversion": "error" // ← noUselessTypeConversion

    // NOT MAPPED — see docs/lint-parity.md for the full accounting:
    //   noReExportAll                → no oxlint rule exists. The `export * from` that Biome caught in
    //                                  the bun-test type shim would pass here.
    //   useSimplifiedLogicExpression → no equivalent.
    //   noFloatingPromises           → typescript/no-floating-promises exists but needs type info,
    //                                  which oxlint does not have in this mode.
    //   useExhaustiveSwitchCases     → typescript/switch-exhaustiveness-check, same reason.
    //   the GritQL naming plugin     → oxlint has no GritQL, and `unicorn/prevent-abbreviations` is
    //                                  absent from its 138 unicorn rules. Verified, not assumed.
    //   useSortedClasses /
    //   noDuplicateClasses /
    //   noUnknownAtRules             → Tailwind and CSS rules. The factory ships no CSS.
    //   organizeImports              → an assist action, not a lint rule. oxlint does not sort imports.
  },

  "overrides": [
    {
      // Mirrors the Biome override that flips noProcessEnv on for tests only.
      "files": ["**/*.test.ts"],
      "rules": {
        "node/no-process-env": "error"
      }
    }
  ]
}
