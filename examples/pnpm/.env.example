# Copy to `.env` (gitignored) and fill in. THIS IS THE ONLY PLACE SECRETS LIVE.
#
# Neither TOML layer ever holds a credential. A service in config.defaults.toml /
# config.local.toml names a variable from this file via `apiKeyEnv`:
#
#   [services.primary]
#   apiKeyEnv = "PRIMARY_API_KEY"      <-- the NAME, in committed config
#
# ...and src/config/config.ts reads the VALUE here, at the point of use. That indirection is what
# makes the TOML files safe to commit and safe to share with a teammate.
#
# Keep this example file in sync when you add a service: it is the only discoverable list of what a
# fresh clone needs set. A variable that exists only in someone's local .env is a setup step nobody
# else can find.

# Named by [services.primary] in config.defaults.toml.
PRIMARY_API_KEY=

# Optional: absolute path to the directory holding config.defaults.toml. Only needed when the config
# does not sit above the working directory — e.g. a container that mounts it elsewhere. Leave unset
# and the loader walks up from the current directory to find it.
# APP_CONFIG_DIR=
