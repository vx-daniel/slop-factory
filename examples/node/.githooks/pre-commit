#!/bin/sh
# Pre-commit gate — runs the full check:all (biome + tsc --noEmit + vitest), the
# single source of "green" (scripts/gate.ts). Wired via core.hooksPath, set by the
# package.json `prepare` script on `npm install`. For a deliberate work-in-progress
# commit, bypass with `git commit --no-verify`.
#
# Git runs hooks from the repo root, which is where package.json lives, so
# `npm run check:all` resolves without changing directory.
set -e
npm run check:all
